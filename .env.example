# API Keys (add your own and rename to .env)
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here   # fallback when primary key hits rate limits

# Optional: HuggingFace for embeddings
HUGGINGFACE_API_KEY=your_hf_key_here

# --- Colab / GPU backend (pick ONE) ---
# Option A: Ollama on Colab (recommended — no HF token needed)
USE_OLLAMA=false

# Option B: HuggingFace 4-bit on GPU (needs HF token + Meta license accepted)
USE_LOCAL_LLM=false
HF_TOKEN=your_hf_token_here
LOCAL_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
